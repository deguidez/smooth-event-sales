# Copie este arquivo para `.env.production` na sua VPS e preencha.
# O arquivo `.env.production` fica só no servidor — ele está fora do Git.
#
#   cp deploy/.env.production.example .env.production
#   nano .env.production
#
# Os valores marcados como "rodtime" são lidos quando o site está rodando.
# Os marcados como "build" são gravados dentro do arquivo do navegador na hora
# do `bun run build:vps` — mudar depois exige build novo.

# ── Banco de dados (o novo, na sua VPS) ────────────────────────────────────────
# URL do Supabase auto-hospedado. Use o endereço do Kong (proxy) do Supabase.
SUPABASE_URL="http://127.0.0.1:8000"                       # runtime
SUPABASE_PUBLISHABLE_KEY=""                                # runtime (chave "anon")
SUPABASE_SERVICE_ROLE_KEY=""                               # runtime (chave "service_role")

# ── Banco de dados visto pelo navegador ────────────────────────────────────────
# Precisa ser um endereço público (https), porque é o celular do atleta que acessa.
VITE_SUPABASE_URL="https://banco.evenon.com.br"            # build
VITE_SUPABASE_PUBLISHABLE_KEY=""                           # build (mesma "anon")

# ── E-mails da aplicação ──────────────────────────────────────────────────────
# Mantém o envio atual (aviso de pagamento, comprovante, fotos).
LOVABLE_API_KEY=""                                         # runtime

# ── Caixa de e-mail do superadmin (Hostinger) ─────────────────────────────────
HOSTINGER_MAIL_API_TOKEN=""                                # runtime

# ── Fotos e vídeos na VPS (MinIO) ─────────────────────────────────────────────
VPS_S3_ENDPOINT="https://foto.evenon.com.br"               # runtime
VPS_S3_BUCKET="evenon-fotos"                               # runtime
VPS_S3_ACCESS_KEY=""                                       # runtime
VPS_S3_SECRET_KEY=""                                       # runtime
VPS_S3_REGION="us-east-1"                                  # runtime

# ── Proteção do disparo automático (automações a cada 5 min) ──────────────────
# Gere um valor aleatório longo e use o mesmo no endereço do cron.
LOVABLE_CRON_SECRET=""                                     # runtime

# ── Asaas ─────────────────────────────────────────────────────────────────────
# A chave da API Asaas e o token do webhook ficam salvos no banco
# (Super admin → Configurações), não neste arquivo.
